# RayuCode RAG support assistant — environment template.
# Copy to `.env` and fill in values. `.env` is gitignored and must never be
# committed. The API key is server-only: it powers the LLM gateway call and
# must never be shipped to the browser or to the frontend.

# --- LLM gateway -----------------------------------------------------------------
# Server-only Rayu API key (starts with rayu_sk_live_). Never commit a real key.
RAYU_BOT_API_KEY=
# Hosted model id used for chat completions.
RAYU_BOT_MODEL=deepseek-v4.1-flash-cloud
# OpenAI-compatible gateway base URL (no trailing /v1).
RAYU_BOT_GATEWAY_URL=https://gateway.rayucode.com

# --- RAG behaviour ---------------------------------------------------------------
# LLM backend: "mock" for offline dev/tests/demo, "gateway" for the real model.
RAYU_RAG_LLM=mock
# Default ranker: keyword | tfidf | bm25 | fusion.
RAYU_RAG_RANKER=keyword
# Refusal score threshold; leave empty to disable score-based refusal.
RAYU_RAG_REFUSAL_THRESHOLD=
# Expose the debug retrieval endpoint (GET /api/retrieve) when "1".
RAYU_RAG_DEBUG=0

# --- Corpus ----------------------------------------------------------------------
# Base URL used to render absolute doc links in the UI.
RAYU_DOCS_SITE_BASE=https://rayucode.com
# Pinned rayu-web commit the frozen corpus was copied from.
RAYU_DOCS_SOURCE_COMMIT=486bab47797719a893e6aae9b9363460cd7f9cce

# --- Rate limits (anonymous support bot) -----------------------------------------
# Sliding-window request budget per IP.
RAYU_BOT_IP_WINDOW_LIMIT=6
# Sliding-window length in minutes.
RAYU_BOT_IP_WINDOW_MINUTES=10
# Per-IP requests per UTC day.
RAYU_BOT_IP_DAILY_LIMIT=50
# Process-wide requests per UTC day.
RAYU_BOT_GLOBAL_DAILY_LIMIT=500
